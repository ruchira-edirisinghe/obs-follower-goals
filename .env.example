# obs-follower-goals settings
# Copy this file to your home folder as  .env.followers  (Windows: C:\Users\<you>\.env.followers)
# and fill in only the platforms you use. Leave a line empty (or delete it) to hide that platform.
# The helper re-reads this file every cycle, so changes apply without a restart.
# Never commit or share your filled-in copy: it can hold API keys.

# ---------- Twitch ----------
# Your channel login (the name in twitch.tv/<login>). No key needed: counts come from DecAPI.
TWITCH_LOGIN=
# Optional, only if you registered your own Twitch app (needs 2FA). Then run: python server.py --twitch-login
TWITCH_CLIENT_ID=

# ---------- YouTube ----------
# Free key: Google Cloud Console > APIs & Services > enable "YouTube Data API v3" > Credentials > API key.
YOUTUBE_API_KEY=
# Either your @handle or your channel ID (UC...).
YOUTUBE_HANDLE=
YOUTUBE_CHANNEL_ID=

# ---------- TikTok ----------
# Your username without the @. Read from your public profile page with a headless browser.
TIKTOK_USERNAME=

# ---------- Facebook ----------
# Your page's username or numeric ID (facebook.com/<this>). Without a token the public page is read.
FACEBOOK_PAGE_ID=
# Optional Graph API page access token (more reliable than reading the public page).
FACEBOOK_PAGE_TOKEN=

# ---------- Advanced (optional) ----------
# Path to Chrome / Edge / Chromium if it isn't found automatically.
BROWSER_PATH=
# Seconds between checks per platform (minimum 15). Defaults: Twitch/YouTube 60, TikTok/Facebook 300.
# TWITCH_EVERY=60
# YOUTUBE_EVERY=60
# TIKTOK_EVERY=300
# FACEBOOK_EVERY=300
